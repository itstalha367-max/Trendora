APP_NAME=Trendora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / XAMPP default local setup
# Create a database named `trendora` in phpMyAdmin, then copy this file to `.env`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trendora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@trendora.test"
MAIL_FROM_NAME="${APP_NAME}"

# RaftarPay: keep sandbox until merchant onboarding/callback testing is complete.
RAFTARPAY_GATEWAY=jazzcash
RAFTARPAY_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_MODE=3d
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_MODE=3d
KUICKPAY_MERCHANT_ID=
KUICKPAY_AUTH_KEY=
KUICKPAY_HASH_KEY=
FAYSAL_MERCHANT_ID=
FAYSAL_MERCHANT_PASSWORD=
FAYSAL_HASH_KEY=
FAYSAL_MODE=3d
MEEZAN_MERCHANT_ID=
MEEZAN_MERCHANT_PASSWORD=
MEEZAN_HASH_KEY=
MEEZAN_MODE=3d

# Demo data is blocked in production unless this is intentionally enabled.
TRENDORA_ALLOW_DEMO_SEED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional non-interactive admin seeder. Prefer: php artisan trendora:admin
TRENDORA_ADMIN_NAME="Trendora Admin"
TRENDORA_ADMIN_EMAIL=
TRENDORA_ADMIN_PASSWORD=
